APP_NAME="Arisan Primatexco"
APP_ENV=local
APP_KEY=
# ⚠️ WAJIB: Set APP_DEBUG=false dan APP_ENV=production di server produksi!
APP_DEBUG=true
APP_URL=http://localhost

# ============================================================
# SECURITY SETTINGS — Wajib disesuaikan sebelum deploy produksi
# ============================================================
# Set FORCE_HTTPS=true di produksi untuk redirect ke HTTPS
FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Rekomendasi: minimal 12 untuk produksi
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# ⚠️ PRODUKSI: Ganti ke LOG_LEVEL=error agar tidak log data sensitif
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
# ⚠️ PRODUKSI: Wajib gunakan password database yang kuat!
DB_PASSWORD=

# SESSION
SESSION_DRIVER=database
SESSION_LIFETIME=120
# ⚠️ PRODUKSI: Set SESSION_ENCRYPT=true dan SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
